{
  description = "kubease Home Manager configuration";

  inputs = {
    nixpkgs.url = "{{ .Channel }}";

    home-manager = {
      url = "{{ .HomeManagerChannel }}";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { nixpkgs, home-manager, ... }: {
    homeConfigurations.{{ quote .Username }} =
      home-manager.lib.homeManagerConfiguration {
        pkgs = nixpkgs.legacyPackages.{{ quote .System }};

        modules = [
          ({ pkgs, ... }: {
            home.username = {{ quote .Username }};
            home.homeDirectory = {{ quote .HomeDirectory }};
            home.stateVersion = {{ quote .HomeStateVersion }};

            programs.home-manager.enable = true;

            home.packages = with pkgs; [
              {{ join .Pkgs }}
            ];
          })
        ];
      };
  };
}
